NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Segredos (gere valores aleatórios >= 32 caracteres / 64 hex chars em produção)
JWT_SECRET="ceub-dev-jwt-secret-altere-em-producao-min-32-chars"
JWT_REFRESH_SECRET="ceub-dev-refresh-secret-altere-em-producao-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Chave AES-256-GCM em hexadecimal (64 caracteres = 32 bytes)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Opcional para HTTPS nativo no Node (em produção recomenda-se TLS no proxy reverso)
# SSL_KEY_PATH=
# SSL_CERT_PATH=
